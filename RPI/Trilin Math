import numpy as np

def trilaterate(anchors, dists):
    (x1, y1), (x2, y2), (x3, y3) = anchors
    r1, r2, r3 = dists
    A = np.array([[2*(x2-x1), 2*(y2-y1)],
                  [2*(x3-x1), 2*(y3-y1)]])
    b = np.array([r1**2 - r2**2 + x2**2 - x1**2 + y2**2 - y1**2,
                  r1**2 - r3**2 + x3**2 - x1**2 + y3**2 - y1**2])
    return np.linalg.lstsq(A, b, rcond=None)[0]

anchors = [(0, 0), (5, 0), (0, 4)]
dists   = [2.5, 3.6, 2.9]
arr = trilaterate(anchors, dists)
print(arr)   # -> [x, y]

arr.tofile("position.csv", sep=",", header="x,y", comments="")


